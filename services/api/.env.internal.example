# CLARA API internal deployment example.
# Copy values into your deployment platform secret/config manager.
# Do not commit real .env files or real credentials.

NODE_ENV=production
APP_NAME=clara-api
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info

AUTH_MODE=provider
AUTH_PROVIDER=supabase
MOCK_AUTH_ENABLED=false
INTERNAL_CRM_RUNTIME_ENABLED=true
SUPABASE_AUTH_JWKS_URL=<provider-jwks-url>
SUPABASE_AUTH_ISSUER=<provider-issuer>

DATABASE_URL=<secret-managed-postgres-url>
CORS_ORIGIN=<explicit-internal-dashboard-origin>

RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000
REQUEST_BODY_LIMIT_BYTES=1048576

EMAIL_CHANNEL_MODE=disabled
AI_PROVIDER_MODE=disabled
GMAIL_PROVIDER_ENABLED=false
GMAIL_API_MODE=disabled
GMAIL_INBOUND_SYNC_SCHEDULER_ENABLED=false

